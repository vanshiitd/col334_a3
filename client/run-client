#!/bin/sh
# Launcher for the HTTP client: run-client URL [-o OUTFILE] [--log LOGFILE]
#
# Our TCP lives in user space, so the kernel has no socket for the
# connection and would answer the server's SYN-ACK (and everything after
# it) with a RST. The client always uses a source port in 61000-65535,
# outside Linux's ephemeral range (32768-60999), so dropping RSTs sent from
# those ports silences the kernel for our connections only. The rule is
# added once and left in place.
if command -v iptables >/dev/null 2>&1; then
    iptables -C OUTPUT -p tcp --sport 61000:65535 --tcp-flags RST RST -j DROP 2>/dev/null ||
        iptables -I OUTPUT -p tcp --sport 61000:65535 --tcp-flags RST RST -j DROP
else
    echo "warning: iptables not found; the kernel may reset our connections" >&2
fi

exec python3 "$(dirname "$0")/../src/http_client.py" "$@"
